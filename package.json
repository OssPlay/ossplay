{
	"name": "ossplay",
	"private": true,
	"version": "0.0.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "turbo run dev",
		"dev:dashboard": "bun --filter @ossplay/dashboard dev",
		"dev:api": "bun --filter @ossplay/api dev",
		"dev:email": "bun --filter @ossplay/email-preview dev",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"format": "biome format --write .",
		"db:generate": "bun --filter @ossplay/db generate",
		"db:migrate": "bun --filter @ossplay/db migrate"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"turbo": "^2.10.7",
		"typescript": "^5.9.3"
	}
}
