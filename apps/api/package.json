{
	"name": "@ossplay/api",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"build": "tsc --noEmit",
		"start": "bun run src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
