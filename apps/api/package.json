		"bullmq": "^5.81.3",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.32",
		"ioredis": "^5.11.1",
		"ssh2": "^1.17.0",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@ossplay/config": "workspace:*",
		"@types/bun": "^1.3.14",
		"@types/ssh2": "^1.15.5",
		"typescript": "^5.9.3"
