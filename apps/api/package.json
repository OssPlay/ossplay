{
  "name": "@ossplay/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "bun test",
    "cli:reset-root": "bun run src/cli/reset-root.ts",
    "cli:reset-db": "bun run src/cli/reset-db.ts"
  },
  "dependencies": {
    "@ossplay/core": "workspace:*",
    "@ossplay/db": "workspace:*",
    "@simplewebauthn/server": "^13.3.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "nodemailer": "^9.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ossplay/config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.9.3"
  }
}
